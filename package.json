{
  "name": "afterlight",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "desktop:assets": "AFTERLIGHT_DESKTOP=1 next build",
    "desktop:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "desktop:build": "tauri build --bundles app --no-sign",
    "desktop:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "desktop:acceptance": "tauri build --bundles app --no-sign --config src-tauri/tauri.acceptance.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "katex": "^0.16.22",
    "next": "^16.2.12",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^30.1.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
